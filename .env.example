# ==============================================================================
# GITHUB ANALYTICS ETL PIPELINE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANTE: Copia este archivo a '.env' y completa con tus datos.
# NUNCA subas el archivo '.env' real a GitHub.

# Configuración de la API de GitHub
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=your_target_github_username

# Configuración de Base de Datos
DATABASE_URL=sqlite:///./analytics_data.db
LOG_LEVEL=INFO

# Modo Simulación (Regla de oro: permitir pruebas sin costos/tokens obligatorios)
USE_MOCK_DATA=true